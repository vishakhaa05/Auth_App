# Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/auth_db?retryWrites=true&w=majority

# JWT Secrets (generate strong random secrets)
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Frontend URL (Render Backend needs this for CORS & reset password emails)
# Set this to your deployed Vercel domain (without trailing slash):
CLIENT_URL=https://<your-frontend-project>.vercel.app

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# OPTION 1: Resend HTTP API (RECOMMENDED for Render / cloud hosting)
# Uses Port 443 HTTPS - 100% immune to Render SMTP connection timeouts.
# Get a free API key at https://resend.com (takes 30 seconds):
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Auth App <onboarding@resend.dev>"

# OPTION 2: Brevo HTTP API (Alternative HTTPS provider - 300 free emails/day)
# Get a free key at https://brevo.com:
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# OPTION 3: Direct SMTP (Gmail or Brevo SMTP)
# NOTE: Render free tier blocks outbound ports 465 and 587 to Gmail, causing
# connection timeouts. For SMTP on Render, use Brevo on port 2525.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_gmail_address@gmail.com
# SMTP_PASS=your_16_character_google_app_password
# EMAIL_FROM=your_gmail_address@gmail.com
# EMAIL_FROM_NAME="Auth App"
